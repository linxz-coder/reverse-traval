<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.reverse-traval.prewarm</string>

  <key>WorkingDirectory</key>
  <string>/Users/lxz/.local/share/reverse-traval</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/lxz/.local/share/reverse-traval/.venv/bin/python</string>
    <string>/Users/lxz/.local/share/reverse-traval/scripts/nightly_prewarm.py</string>
    <string>--batch-size</string>
    <string>5</string>
    <string>--holiday-count</string>
    <string>3</string>
    <string>--profiles</string>
    <string>quality</string>
    <string>--delay-seconds</string>
    <string>60</string>
    <string>--priority-cities</string>
    <string>深圳,广州,东莞,惠州,佛山,珠海,中山,江门,汕尾,肇庆,韶关,河源,清远,云浮,北京,上海</string>
    <string>--international-count</string>
    <string>3</string>
    <string>--start-hour</string>
    <string>2</string>
    <string>--latest-start-hour</string>
    <string>6</string>
    <string>--max-runtime-seconds</string>
    <string>19800</string>
    <string>--wait</string>
    <string>--watch-interval</string>
    <string>60</string>
    <string>--watch-timeout</string>
    <string>21600</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/lxz/.local/share/reverse-traval/.cache/logs/nightly-prewarm.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lxz/.local/share/reverse-traval/.cache/logs/nightly-prewarm.err.log</string>
</dict>
</plist>
