[Unit]
Description=Start reverse travel nightly cache prewarm
After=reverse-traval.service
Wants=reverse-traval.service

[Service]
Type=oneshot
User=reverse_travel
Group=reverse_travel
WorkingDirectory=/opt/reverse-traval
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=7h
ExecStart=/opt/reverse-traval/.venv/bin/python /opt/reverse-traval/scripts/nightly_prewarm.py --batch-size 9 --holiday-count 3 --profiles default,quality --delay-seconds 45 --priority-cities 深圳,广州 --prewarm-coverage --allowed-hours 0-7,22-23 --slot-rotation-hours 2 --max-runtime-seconds 5400 --wait --watch-interval 60 --watch-timeout 7200
